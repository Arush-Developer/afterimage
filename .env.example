# AFTERIMAGE backend configuration (all optional; defaults shown).
# Copy to backend/.env or export in your shell. Never commit real values.

# Where the SQLite database, synthetic workspaces and recovery vault live.
AFTERIMAGE_DATA_DIR=./data

# Comma-separated list of browser origins allowed by CORS (no wildcards).
AFTERIMAGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum bytes the demo agent may read from a single file.
AFTERIMAGE_MAX_READ_BYTES=65536

# ---- LLM agent -------------------------------------------------------------
# Default provider for LLM runs, experiments and AI explanations:
#   anthropic | ollama | simulated   (simulated = rule-based stand-in, no LLM, no key)
AFTERIMAGE_LLM_PROVIDER=anthropic
# Model override (empty = provider default: claude-opus-5-5 / llama3.1).
AFTERIMAGE_LLM_MODEL=
# Anthropic effort level: low | medium | high | xhigh | max (empty = don't send).
AFTERIMAGE_LLM_EFFORT=medium
AFTERIMAGE_LLM_TIMEOUT_S=120
AFTERIMAGE_LLM_MAX_STEPS=12
AFTERIMAGE_LLM_MAX_TOKENS=16000
AFTERIMAGE_LLM_MAX_TRIALS=5

# Anthropic credentials are read by the official SDK from the PROCESS environment, not
# from this file: export ANTHROPIC_API_KEY in the shell that starts the backend (or run
# `ant auth login`). AFTERIMAGE never stores, logs or returns the key.
# Optional: point the Anthropic SDK at a different endpoint (proxy / mock server).
# AFTERIMAGE_ANTHROPIC_BASE_URL=

# Optional local Ollama server.
AFTERIMAGE_OLLAMA_HOST=http://127.0.0.1:11434

# Optional cloud sync is NOT implemented in this prototype. Leave unset.
# AFTERIMAGE_CLOUD_SYNC=disabled
