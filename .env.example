# AFTERIMAGE backend configuration (all optional; defaults shown).
# Copy to backend/.env or export in your shell. Never commit real values.

# Where the SQLite database, synthetic workspaces and recovery vault live.
AFTERIMAGE_DATA_DIR=./data

# Comma-separated list of browser origins allowed by CORS (no wildcards).
AFTERIMAGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum bytes the demo agent may read from a single file.
AFTERIMAGE_MAX_READ_BYTES=65536

# ---- LLM agent -------------------------------------------------------------
# Default provider for LLM runs, experiments and AI explanations:
#   anthropic | gemini | ollama | simulated   (simulated = rule-based stand-in, no LLM, no key)
# There is NO automatic fallback between providers: a failing provider reports an error.
AFTERIMAGE_LLM_PROVIDER=anthropic
# Model override for the DEFAULT provider only (empty = that provider's default).
AFTERIMAGE_LLM_MODEL=
# Per-provider models (empty = built-in default). These never leak across providers.
# Anthropic default: claude-opus-5-5
AFTERIMAGE_ANTHROPIC_MODEL=
# Gemini default: gemini-2.5-flash (use Settings > Check to confirm it is available to your key)
AFTERIMAGE_GEMINI_MODEL=
# Ollama default: llama3.1 (the model must support tool calling)
AFTERIMAGE_OLLAMA_MODEL=
# Anthropic effort level: low | medium | high | xhigh | max (empty = don't send).
AFTERIMAGE_LLM_EFFORT=medium
AFTERIMAGE_LLM_TIMEOUT_S=120
AFTERIMAGE_LLM_MAX_STEPS=12
AFTERIMAGE_LLM_MAX_TOKENS=16000
AFTERIMAGE_LLM_MAX_TRIALS=5

# ---- Credentials -------------------------------------------------------------
# API keys are read from the PROCESS environment only, never from this file and never
# sent to the browser. Export them in the shell that starts the backend:
#   export ANTHROPIC_API_KEY=sk-ant-...        (or run `ant auth login`)
#   export GEMINI_API_KEY=...                  (from Google AI Studio; a free-tier key works)
# GOOGLE_API_KEY and Vertex AI settings are deliberately NOT used for Gemini.
# AFTERIMAGE never stores, logs or returns any key.

# ---- Gemini ----------------------------------------------------------------------
# Per-minute rate limits (HTTP 429) are retried up to N times, honouring the server's
# retry delay if it is at most MAX_RETRY_WAIT_S. Daily/free-tier quota exhaustion is never retried.
AFTERIMAGE_GEMINI_RATE_LIMIT_RETRIES=2
AFTERIMAGE_GEMINI_MAX_RETRY_WAIT_S=30
# Optional: point the Gemini SDK at a different endpoint (proxy / mock server for tests).
# AFTERIMAGE_GEMINI_BASE_URL=
# Optional: point the Anthropic SDK at a different endpoint (proxy / mock server).
# AFTERIMAGE_ANTHROPIC_BASE_URL=

# ---- Ollama (local) --------------------------------------------------------------
# Must be a loopback address so inference stays on this machine.
AFTERIMAGE_OLLAMA_HOST=http://127.0.0.1:11434
# Set to 1 ONLY if you deliberately want a non-local Ollama host (prompts then leave this machine).
# AFTERIMAGE_OLLAMA_ALLOW_REMOTE=0

# Optional cloud sync is NOT implemented in this prototype. Leave unset.
# AFTERIMAGE_CLOUD_SYNC=disabled
